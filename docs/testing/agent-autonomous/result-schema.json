{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldengine.local/schemas/agent-autonomous-result.schema.json",
  "title": "WorldEngine Agent Autonomous Result",
  "type": "object",
  "required": [
    "scenario",
    "goal",
    "mode",
    "status",
    "verdict_source",
    "score_items",
    "required_artifacts",
    "artifacts",
    "operation_log",
    "unverified_items",
    "failures"
  ],
  "properties": {
    "scenario": {
      "enum": [
        "autonomous-dashboard-basic-runtime",
        "autonomous-dashboard-params-flow",
        "autonomous-dashboard-invalid-param",
        "autonomous-dashboard-agent-autotune",
        "autonomous-dashboard-timeline-investigation",
        "worldengine-full-lifecycle-autonomous",
        "provider-live-smoke-deepseek",
        "llm-backed-world-creation",
        "world-rule-parameter-evolution",
        "rule-compliant-event-generation",
        "agent-persistent-autonomy-evidence",
        "llm-backed-full-lifecycle-autonomous"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["pass", "fail", "blocked", "not_run"]
    },
    "verdict_source": {
      "enum": ["scorecard_checker", "deterministic_checker"]
    },
    "score_items": {
      "type": "array",
      "minItems": 1
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object"
    },
    "operation_log": {
      "type": "string",
      "minLength": 1
    },
    "unverified_items": {
      "type": "array"
    },
    "failures": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
