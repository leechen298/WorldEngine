{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldengine.local/schemas/agent-smoke-result.schema.json",
  "title": "WorldEngine Agent Smoke Result",
  "type": "object",
  "required": [
    "scenario",
    "status",
    "verdict_source",
    "agent_summary",
    "commands",
    "artifacts",
    "assertions",
    "failures"
  ],
  "properties": {
    "scenario": {
      "const": "dashboard-basic-runtime"
    },
    "status": {
      "const": "pass"
    },
    "verdict_source": {
      "const": "deterministic_checker"
    },
    "agent_summary": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["transcript", "console_log", "api_summary", "operation_log", "screenshots"],
      "properties": {
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "console_log": {
          "type": "string",
          "minLength": 1
        },
        "api_summary": {
          "type": "string",
          "minLength": 1
        },
        "operation_log": {
          "type": "string",
          "minLength": 1
        },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "pass"
          },
          "evidence": {}
        }
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 0
    }
  },
  "additionalProperties": true
}
