{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldengine.local/schemas/v0.7-readiness-manifest.schema.json",
  "title": "WorldEngine v0.7 Readiness Manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "manifest_version",
    "engine_reference",
    "generated_from",
    "contract_surfaces",
    "schema_surfaces",
    "template_surfaces",
    "capability_areas",
    "readiness_claim_values",
    "evidence_references",
    "compatibility_notes",
    "redaction_rules"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "engine_reference": {
      "type": "object",
      "required": ["version", "source"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "generated_from": {
      "type": "string",
      "minLength": 1,
      "allOf": [{ "$ref": "#/$defs/noForbiddenText" }]
    },
    "contract_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "schema_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "template_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "capability_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "readiness_claim_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "contract ready",
          "report format ready",
          "core-side compatibility ready",
          "external suite pass",
          "blocked",
          "skipped",
          "out of scope",
          "projection consumer contract ready",
          "projection report format ready",
          "external consumer pass"
        ]
      }
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "contract ready",
              "report format ready",
              "blocked",
              "skipped",
              "out of scope"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(/Users/|/home/|file://|data-testid\\s*=|querySelector\\s*\\(|(^|\\s)(#[A-Za-z][A-Za-z0-9_-]*|\\.[A-Za-z][A-Za-z0-9_-]*|[A-Za-z][A-Za-z0-9_-]*\\[[^\\]]+\\])|hidden[-_ ]?reset|/internal/reset|private[-_ ]?(runner|suite|fixture)|validation\\s+oracle|private\\s+transcript|seed[-_ ]?data|event[-_ ]?payload)"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "historical": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "compatibility_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "allOf": [{ "$ref": "#/$defs/noForbiddenText" }]
      }
    },
    "redaction_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "allOf": [{ "$ref": "#/$defs/noConcreteLeakText" }]
      }
    }
  },
  "$defs": {
    "noForbiddenText": {
      "not": {
        "pattern": "(/Users/|/home/|file://|data-testid\\s*=|querySelector\\s*\\(|(^|\\s)(#[A-Za-z][A-Za-z0-9_-]*|\\.[A-Za-z][A-Za-z0-9_-]*|[A-Za-z][A-Za-z0-9_-]*\\[[^\\]]+\\])|hidden[-_ ]?reset|/internal/reset|private[-_ ]?(runner|suite|fixture)|validation\\s+oracle|private\\s+transcript|seed[-_ ]?data|event[-_ ]?payload)"
      }
    },
    "noConcreteLeakText": {
      "not": {
        "pattern": "(/Users/|/home/|file://|data-testid\\s*=|querySelector\\s*\\(|(^|\\s)(#[A-Za-z][A-Za-z0-9_-]*|\\.[A-Za-z][A-Za-z0-9_-]*|[A-Za-z][A-Za-z0-9_-]*\\[[^\\]]+\\]))"
      }
    },
    "surface": {
      "type": "object",
      "required": ["id", "path", "status", "capability_area"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "status": {
          "enum": [
            "contract ready",
            "report format ready",
            "blocked",
            "skipped",
            "out of scope"
          ]
        },
        "capability_area": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "allOf": [{ "$ref": "#/$defs/noForbiddenText" }]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
